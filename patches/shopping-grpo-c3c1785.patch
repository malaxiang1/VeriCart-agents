diff --git a/src/shopping_grpo/training/grpo/dynamic_sampling.py b/src/shopping_grpo/training/grpo/dynamic_sampling.py
index 5427ff1..30dfea6 100644
--- a/src/shopping_grpo/training/grpo/dynamic_sampling.py
+++ b/src/shopping_grpo/training/grpo/dynamic_sampling.py
@@ -362,3 +362,218 @@ def select_reward_varying_groups(
         "groups": tuple(groups),
     }
     return trajectory_indices, stats
+
+
+def select_partial_valid_groups(
+    uids: Sequence[Hashable],
+    seq_rewards: Sequence[float],
+    *,
+    terminal_utilities: Sequence[float],
+    purchase_success: Sequence[bool],
+    sampling_invalid: Sequence[bool],
+    sampling_invalid_reasons: Sequence[Sequence[str]],
+    tolerance: float = 1.0e-8,
+    min_valid_trajectories: int = 2,
+) -> tuple[list[int], dict[str, Any]]:
+    """Select only explicitly valid, reward-varying members of each GRPO group.
+
+    A sampling-invalid trajectory has no trustworthy terminal reward and must not
+    be converted into a zero-reward example.  This selector therefore retains a
+    partial group only when at least two explicitly valid trajectories remain and
+    their terminal utilities still differ.  The caller is responsible for packing
+    retained groups into an FSDP-compatible optimizer batch.
+    """
+    if min_valid_trajectories < 2:
+        raise ValueError("min_valid_trajectories must be at least two for GRPO")
+    if tolerance < 0 or not math.isfinite(tolerance):
+        raise ValueError(f"tolerance must be a finite non-negative number, got {tolerance!r}")
+
+    sequences = {
+        "seq_rewards": seq_rewards,
+        "terminal_utilities": terminal_utilities,
+        "purchase_success": purchase_success,
+        "sampling_invalid": sampling_invalid,
+        "sampling_invalid_reasons": sampling_invalid_reasons,
+    }
+    for name, values in sequences.items():
+        if len(values) != len(uids):
+            raise ValueError(f"{name} must have the same length as uids")
+
+    grouped: dict[Hashable, dict[str, Any]] = {}
+    for index, values in enumerate(
+        zip(
+            uids,
+            seq_rewards,
+            terminal_utilities,
+            purchase_success,
+            sampling_invalid,
+            sampling_invalid_reasons,
+            strict=True,
+        )
+    ):
+        uid, raw_reward, raw_utility, raw_success, raw_invalid, raw_reasons = values
+        try:
+            hash(uid)
+        except TypeError as exc:
+            raise ValueError(f"uid at index {index} is not hashable: {uid!r}") from exc
+        reward = float(raw_reward)
+        utility = float(raw_utility)
+        if not math.isfinite(reward):
+            raise ValueError(f"seq_reward at index {index} is not finite: {raw_reward!r}")
+        if not math.isfinite(utility):
+            raise ValueError(
+                f"terminal_utility at index {index} is not finite: {raw_utility!r}"
+            )
+        group = grouped.setdefault(
+            uid,
+            {
+                "uid": uid,
+                "indices": [],
+                "rewards": [],
+                "terminal_utilities": [],
+                "purchase_success": [],
+                "sampling_invalid": [],
+                "sampling_invalid_reasons": [],
+            },
+        )
+        group["indices"].append(index)
+        group["rewards"].append(reward)
+        group["terminal_utilities"].append(utility)
+        group["purchase_success"].append(bool(raw_success))
+        group["sampling_invalid"].append(bool(raw_invalid))
+        group["sampling_invalid_reasons"].append(tuple(str(reason) for reason in raw_reasons))
+
+    kept_indices: list[int] = []
+    kept_uids: list[Hashable] = []
+    groups: list[dict[str, Any]] = []
+    for uid, group in grouped.items():
+        valid_positions = [
+            position
+            for position, invalid in enumerate(group["sampling_invalid"])
+            if not invalid
+        ]
+        retained_indices = tuple(group["indices"][position] for position in valid_positions)
+        retained_utilities = tuple(
+            group["terminal_utilities"][position] for position in valid_positions
+        )
+        retained_rewards = tuple(group["rewards"][position] for position in valid_positions)
+        retained_success = tuple(
+            group["purchase_success"][position] for position in valid_positions
+        )
+        valid_count = len(retained_indices)
+        utility_varying = (
+            valid_count >= min_valid_trajectories
+            and max(retained_utilities) - min(retained_utilities) > tolerance
+        )
+        if valid_count < min_valid_trajectories:
+            drop_reason = "insufficient_valid_trajectories"
+        elif not utility_varying:
+            drop_reason = "constant_valid_reward"
+        else:
+            drop_reason = None
+        keep = drop_reason is None
+        if keep:
+            kept_uids.append(uid)
+            kept_indices.extend(retained_indices)
+        reasons = tuple(
+            sorted(
+                {
+                    reason
+                    for reasons_for_member in group["sampling_invalid_reasons"]
+                    for reason in reasons_for_member
+                }
+            )
+        )
+        groups.append(
+            {
+                "uid": uid,
+                "indices": tuple(group["indices"]),
+                "rewards": tuple(group["rewards"]),
+                "terminal_utilities": tuple(group["terminal_utilities"]),
+                "purchase_success": tuple(group["purchase_success"]),
+                "sampling_invalid_members": tuple(group["sampling_invalid"]),
+                "sampling_invalid": any(group["sampling_invalid"]),
+                "sampling_invalid_reasons": reasons,
+                "retained_indices": retained_indices,
+                "retained_rewards": retained_rewards,
+                "retained_terminal_utilities": retained_utilities,
+                "retained_purchase_success": retained_success,
+                "valid_trajectory_count": valid_count,
+                "partial_valid": valid_count < len(group["indices"]),
+                "reward_varying": utility_varying,
+                "drop_reason": drop_reason,
+                "kept": keep,
+            }
+        )
+
+    stats = {
+        "num_trajectories": len(uids),
+        "num_groups": len(grouped),
+        "kept_group_count": len(kept_uids),
+        "dropped_group_count": len(groups) - len(kept_uids),
+        "kept_uids": tuple(kept_uids),
+        "kept_trajectory_count": len(kept_indices),
+        "partial_kept_group_count": sum(
+            group["kept"] and group["partial_valid"] for group in groups
+        ),
+        "insufficient_valid_group_count": sum(
+            group["drop_reason"] == "insufficient_valid_trajectories"
+            for group in groups
+        ),
+        "constant_valid_group_count": sum(
+            group["drop_reason"] == "constant_valid_reward" for group in groups
+        ),
+        "sampling_invalid_group_count": sum(
+            any(group["sampling_invalid_members"]) for group in groups
+        ),
+        "all_equal_group_count": sum(not group["reward_varying"] for group in groups),
+        "all_zero_utility_group_count": sum(
+            max(abs(value) for value in group["terminal_utilities"]) <= tolerance
+            for group in groups
+        ),
+        "all_purchase_success_group_count": sum(
+            all(group["purchase_success"]) for group in groups
+        ),
+        "no_purchase_success_group_count": sum(
+            not any(group["purchase_success"]) for group in groups
+        ),
+        "groups": tuple(groups),
+    }
+    return kept_indices, stats
+
+
+def select_exact_trajectory_pack(
+    group_sizes: Sequence[int], target_trajectories: int
+) -> tuple[int, ...] | None:
+    """Return a deterministic subset of group positions that exactly fills a batch.
+
+    Retained partial groups have two to four trajectories.  The actor's FSDP
+    minibatch must still have a globally divisible size, so greedy acceptance is
+    insufficient (for example, ``3 + 4`` blocks a later ``3 + 2`` pack for 8).
+    """
+    if target_trajectories <= 0:
+        raise ValueError("target_trajectories must be positive")
+    reachable: dict[int, tuple[int, ...]] = {0: ()}
+    for position, raw_size in enumerate(group_sizes):
+        size = int(raw_size)
+        if size <= 0:
+            raise ValueError(f"group size at position {position} must be positive")
+        for total in sorted(tuple(reachable), reverse=True):
+            next_total = total + size
+            if next_total <= target_trajectories and next_total not in reachable:
+                reachable[next_total] = reachable[total] + (position,)
+    return reachable.get(target_trajectories)
+
+
+def select_largest_divisible_trajectory_pack(
+    group_sizes: Sequence[int], *, max_trajectories: int, divisor: int, min_trajectories: int = 2
+) -> tuple[int, ...] | None:
+    """Select the largest pack whose trajectory count is divisible across DP ranks."""
+    if max_trajectories <= 0 or divisor <= 0 or min_trajectories <= 0:
+        raise ValueError("packing bounds and divisor must be positive")
+    for target in range(max_trajectories, min_trajectories - 1, -1):
+        if target % divisor == 0:
+            pack = select_exact_trajectory_pack(group_sizes, target)
+            if pack is not None:
+                return pack
+    return None
